import 'package:flutter/material.dart';
import 'package:provider/provider.dart';
import 'package:shared_preferences/shared_preferences.dart';

import 'package:img_syncer/global.dart';
import 'package:img_syncer/design_tokens.dart';
import 'package:img_syncer/state_model.dart';
import 'package:img_syncer/settings/theme_controller.dart';
import 'package:img_syncer/settings/dock_style_controller.dart';
import 'package:img_syncer/settings/settings_dock.dart';

/// 二级页：外观与主题 —— 主题风格（弹窗选择）、深色模式（弹窗选择）、相册列数。
class SettingsAppearancePage extends StatelessWidget {
  const SettingsAppearancePage({Key? key}) : super(key: key);

  @override
  Widget build(BuildContext context) {
    final colorScheme = Theme.of(context).colorScheme;
    return Scaffold(
      appBar: AppBar(title: Text(l10n.appearanceAndTheme)),
      body: ListView(
        padding: const EdgeInsets.symmetric(vertical: AppSpacing.sm),
        children: [
          // ── 主题风格 ──
          Card(
            child: Consumer<ThemeController>(
              builder: (context, controller, _) {
                final currentLabel = controller.isMiuix
                    ? l10n.themeMiuix
                    : l10n.themeMaterial3;
                final currentDesc = controller.isMiuix
                    ? l10n.themeMiuixDesc
                    : l10n.themeMaterial3Desc;
                return Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    ListTile(
                      leading: const Icon(Icons.palette_outlined, size: 26),
                      title: Text(l10n.themeStyle),
                      subtitle: Text(
                        '$currentLabel  ·  $currentDesc',
                        style: Theme.of(context).textTheme.bodySmall?.copyWith(
                              color: colorScheme.onSurfaceVariant,
                            ),
                      ),
                      trailing: Icon(
                        Icons.chevron_right,
                        color: colorScheme.onSurfaceVariant,
                      ),
                      onTap: () => _showThemeModeDialog(context, controller),
                    ),
                  ],
                );
              },
            ),
          ),
          // ── 深色模式 ──
          Card(
            child: Consumer<ThemeController>(
              builder: (context, controller, _) {
                final currentLabel = _darkModeLabel(controller.darkMode);
                return Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    ListTile(
                      leading: const Icon(Icons.dark_mode_outlined, size: 26),
                      title: Text(l10n.darkMode),
                      subtitle: Text(
                        currentLabel,
                        style: Theme.of(context).textTheme.bodySmall?.copyWith(
                              color: colorScheme.onSurfaceVariant,
                            ),
                      ),
                      trailing: Icon(
                        Icons.chevron_right,
                        color: colorScheme.onSurfaceVariant,
                      ),
                      onTap: () => _showDarkModeDialog(context, controller),
                    ),
                  ],
                );
              },
            ),
          ),
          // ── Dock 设置入口 ──
          Card(
            child: Consumer<DockStyleController>(
              builder: (context, controller, _) {
                final summary =
                    '${_dockStyleLabel(controller.style)} · ${_dockOpacityLabel(controller.opacity)} · ${_dockBlurLabel(controller.blur)}';
                return ListTile(
                  leading: const Icon(Icons.layers_outlined, size: 26),
                  title: Text('Dock 设置'),
                  subtitle: Text(
                    summary,
                    style: Theme.of(context).textTheme.bodySmall?.copyWith(
                          color: colorScheme.onSurfaceVariant,
                        ),
                  ),
                  trailing: Icon(
                    Icons.chevron_right,
                    color: colorScheme.onSurfaceVariant,
                  ),
                  onTap: () => Navigator.push(
                    context,
                    MaterialPageRoute(
                      builder: (context) => const SettingsDockPage(),
                    ),
                  ),
                );
              },
            ),
          ),
          // ── 相册列数 ──
          Card(
            child: Consumer<SettingModel>(
              builder: (context, model, _) => Column(
                children: [
                  ListTile(
                    leading: const Icon(Icons.grid_view_outlined, size: 26),
                    title: Text(l10n.galleryColumnCount),
                    subtitle: Text(
                      '${model.galleryColumCount}',
                      style: Theme.of(context).textTheme.bodyMedium?.copyWith(
                            color: colorScheme.primary,
                          ),
                    ),
                    trailing: SizedBox(
                      width: 140,
                      child: Slider(
                        min: 2,
                        max: 10,
                        divisions: 8,
                        value: model.galleryColumCount.toDouble(),
                        label: '${model.galleryColumCount}',
                        onChanged: (value) async {
                          final count = value.round();
                          model.setGalleryColumCount(count);
                          final prefs = await SharedPreferences.getInstance();
                          await prefs.setInt('galleryColumCount', count);
                        },
                      ),
                    ),
                  ),
                ],
              ),
            ),
          ),
        ],
      ),
    );
  }

  /// 主题风格弹窗：单选列表，选择后自动生效并关闭。
  void _showThemeModeDialog(BuildContext context, ThemeController controller) {
    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        title: Text(l10n.themeStyle),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            RadioListTile<PhoThemeMode>(
              title: Text(l10n.themeMiuix),
              subtitle: Text(
                l10n.themeMiuixDesc,
                style: Theme.of(context).textTheme.bodySmall?.copyWith(
                      color: Theme.of(context).colorScheme.onSurfaceVariant,
                    ),
              ),
              value: PhoThemeMode.miuix,
              groupValue: controller.mode,
              onChanged: (v) {
                if (v != null) controller.setMode(v);
                Navigator.pop(context);
              },
            ),
            RadioListTile<PhoThemeMode>(
              title: Text(l10n.themeMaterial3),
              subtitle: Text(
                l10n.themeMaterial3Desc,
                style: Theme.of(context).textTheme.bodySmall?.copyWith(
                      color: Theme.of(context).colorScheme.onSurfaceVariant,
                    ),
              ),
              value: PhoThemeMode.material3,
              groupValue: controller.mode,
              onChanged: (v) {
                if (v != null) controller.setMode(v);
                Navigator.pop(context);
              },
            ),
          ],
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context),
            child: Text(l10n.cancel),
          ),
        ],
      ),
    );
  }

  /// 深色模式弹窗：单选列表，选择后自动生效并关闭。
  void _showDarkModeDialog(BuildContext context, ThemeController controller) {
    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        title: Text(l10n.darkMode),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            RadioListTile<PhoDarkMode>(
              title: Text(l10n.darkModeLight),
              value: PhoDarkMode.light,
              groupValue: controller.darkMode,
              onChanged: (v) {
                if (v != null) controller.setDarkMode(v);
                Navigator.pop(context);
              },
            ),
            RadioListTile<PhoDarkMode>(
              title: Text(l10n.darkModeDark),
              value: PhoDarkMode.dark,
              groupValue: controller.darkMode,
              onChanged: (v) {
                if (v != null) controller.setDarkMode(v);
                Navigator.pop(context);
              },
            ),
            RadioListTile<PhoDarkMode>(
              title: Text(l10n.darkModeSystem),
              value: PhoDarkMode.system,
              groupValue: controller.darkMode,
              onChanged: (v) {
                if (v != null) controller.setDarkMode(v);
                Navigator.pop(context);
              },
            ),
          ],
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context),
            child: Text(l10n.cancel),
          ),
        ],
      ),
    );
  }

  /// 深色模式枚举 → 显示文本。
  String _darkModeLabel(PhoDarkMode mode) {
    if (mode == PhoDarkMode.light) return l10n.darkModeLight;
    if (mode == PhoDarkMode.dark) return l10n.darkModeDark;
    return l10n.darkModeSystem;
  }

  /// Dock 风格 → 显示文本。
  String _dockStyleLabel(DockStyle style) {
    if (style == DockStyle.frosted) return l10n.dockStyleFrosted;
    if (style == DockStyle.mica) return l10n.dockStyleMica;
    return l10n.dockStyleSolid;
  }

  /// Dock 透明度 → 显示文本。
  String _dockOpacityLabel(DockOpacity op) {
    if (op == DockOpacity.high) return l10n.dockOpacityHigh;
    if (op == DockOpacity.low) return l10n.dockOpacityLow;
    return l10n.dockOpacityMedium;
  }

  /// Dock 模糊度 → 显示文本。
  String _dockBlurLabel(DockBlur blur) {
    if (blur == DockBlur.light) return l10n.dockBlurLight;
    if (blur == DockBlur.strong) return l10n.dockBlurStrong;
    return l10n.dockBlurMedium;
  }

  /// Dock 设置跳转由 [SettingsDockPage] 提供，本页不再保留弹窗逻辑。
}
